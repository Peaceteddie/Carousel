{
	"manifest_version": 3,
	"name": "Image Gallery Extension",
	"version": "1.0",
	"description": "An extension to create image galleries from web pages",
	"permissions": [
		"activeTab",
		"contextMenus",
		"scripting",
		"storage",
		"tabs"
	],
	"host_permissions": [
		"http://*/*",
		"https://*/*"
	],
	"background": {
		"service_worker": "dist/background.js",
		"type": "module"
	},
	"content_scripts": [
		{
			"matches": [
				"<all_urls>"
			],
			"js": [
				"dist/content.js"
			]
		}
	],
	"web_accessible_resources": [
		{
			"resources": [
				"dist/swiper-bundle.min.css",
				"dist/swiper-bundle.min.js"
			],
			"matches": [
				"<all_urls>"
			]
		}
	],
	"action": {
		"default_popup": "src/popup/popup.html"
	},
	"icons": {
		"16": "images/icon-16.png",
		"32": "images/icon-32.png",
		"48": "images/icon-48.png",
		"128": "images/icon-128.png"
	}
}